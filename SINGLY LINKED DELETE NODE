import java.util.*;
class Node{
    int data;
    Node next;

    Node(int data){
        this.data=data;
        this.next=null;
    }
}

public class Main {
    static Node head=null;
    static Node tail=null;
    public static void inserAt(int n,Scanner sc){
  
    for(int i=0;i<n;i++){
        int k=sc.nextInt();
Node newNode=new Node(k);
        if(head == null ){
            head=newNode;
            tail =newNode;
        }
        else{
           
            tail.next=newNode;
            tail=newNode;
        }
    }
    }
   
    static void removeelement(int target){

      while(head != null && head.data == target){
        head=head.next;
      }
      Node curr=head;

      while(curr != null && curr.next != null){
            if(curr.next.data == target){
                curr.next=curr.next.next;
            }
            else{
                curr=curr.next;
            }
      }

    }
static void print(){
    Node temp =head;
boolean t=true;


    while(temp != null ){
        if(!t){
            System.out.print(" ");
        }
        System.out.print(temp.data);
        t=false;
        temp=temp.next;
    }
    System.out.println();
}
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
        inserAt(n,sc);
        int target=sc.nextInt();
        removeelement(target);
        print();

    }
}
