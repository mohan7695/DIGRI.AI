import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
       
        PriorityQueue<Integer> pq=new PriorityQueue<>();

            for(int i=0;i<n;i++){
                pq.offer(sc.nextInt());
            }
            int k=sc.nextInt();
      int max=0;
            for(int i=0;i<k;i++){
                max=pq.remove();
            }
            System.out.println(max);
    }
}
