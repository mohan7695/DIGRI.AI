import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
Stack<Integer> stack=new Stack<>();
        for(int i=0;i<n;i++){
            String  k=sc.next();

            if(k.equals("+")){
                int a=stack.pop();
                int b=stack.pop();

                int d=a+b;

                stack.push(d);
            }
            else if(k.equals("-")){
                int b=stack.pop();
                int a=stack.pop();

                int d=a-b;

                stack.push(d);
            }
            else if(k.equals("*")){
                int a=stack.pop();
                int b=stack.pop();

                int d=a*b;
                stack.push(d);
            }
            else if(k.equals("/")){
                int b=stack.pop();
                int a=stack.pop();

                int d=a/b;

                stack.push(d);
            }
            else{
                stack.push(Integer.parseInt(k));
            }
        }
        System.out.println(stack.peek());
    }
}
