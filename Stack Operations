import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
Stack<String> stack=new Stack<>();
        for(int i=0;i<n;i++){
            String k= sc.next();

            if(k.equals("ADD")){
                String g=sc.next();
                stack.add(g);
            }
            else if(k.equals("REMOVE")){
                if(!stack.isEmpty()){
                    stack.pop();
                }
            }
            else if(k.equals("CHECK")){
                if(stack.isEmpty()){
                    System.out.println("Empty");
                }
                else{
                    System.out.println(stack.peek());
                }
            }
        }
    }
}
