import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code hereS
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
    int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
int left=0;
int right=arr.length-1;
while(left < right){
    int mid=(left+right)/2;

    if(arr[mid] > arr[right]){
        left=mid+1;
    }
    else{
        right=mid;
    }
}
int min=arr[left];
int count=left;
System.out.println(min+" "+count);
       
    }
}
