import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);
        int count=0;
        int n=sc.nextInt();
        int[] arr=new int[n];

        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
int[] nums =new int[n];
        for(int k : arr){
            if(k !=0 ){
                nums[count++]=k;
            }
        }
        while(count < nums.length){
nums[count++]=0;
        }

        for(int i=0;i<n;i++){
            System.out.print(nums[i]+" ");
        }
    }
}
